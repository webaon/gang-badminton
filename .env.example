# =============================================================================
# Gang Badminton — ตัวแปรสภาพแวดล้อม
# =============================================================================
# คัดลอกเป็น `.env.local` แล้วเติมค่าจริง (`.env*.local` ถูก gitignore ไว้แล้ว)
#
# 🔴 ห้าม commit ค่าจริงลง repo เด็ดขาด โดยเฉพาะ SERVICE_ROLE_KEY กับ CRON_SECRET
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# ค่าสำหรับ local ดูได้จาก `npm run supabase -- status -o env`
# ค่าสำหรับ cloud ดูที่ Dashboard → Project Settings → API

# เปิดเผยฝั่ง browser ได้ (NEXT_PUBLIC_*) — ใช้กับ client ที่ทำงานภายใต้ RLS
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔴 ฝั่ง server เท่านั้น — service role **bypass RLS ทั้งหมด**
# หลัง WO-1.4 ทุก DB function ถูก revoke จาก anon/authenticated แล้ว
# ⇒ นี่คือกุญแจเดียวที่เรียก register_to_session / transition_session ฯลฯ ได้
# หลุดเมื่อไหร่ = เปิดข้อมูลทุกก๊วนให้คนทั้งอินเทอร์เน็ต
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Cron
# -----------------------------------------------------------------------------
# Vercel Cron ส่งมาเป็น header `Authorization: Bearer <CRON_SECRET>`
# ตั้งค่าเดียวกันใน Vercel → Project Settings → Environment Variables
#
# ⚠️ ไม่ตั้งค่านี้ = endpoint `/api/cron/*` ปฏิเสธทุก request (fail-closed ตั้งใจ)
# สร้างค่าสุ่ม: openssl rand -base64 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# LINE (Phase 4)
# -----------------------------------------------------------------------------
# ⚠️ Channel access token / channel secret ของแต่ละก๊วน **ไม่ได้อยู่ที่นี่** —
#    แอดมินกรอกในหน้าตั้งค่าก๊วน แล้วระบบเก็บลง Supabase Vault (WO-4.A)
#
# ค่าด้านล่างเป็นของระบบ ไม่ใช่ของก๊วนใดก๊วนหนึ่ง
#
# [WO-4.B/4.D] key สำหรับเซ็น "รหัสผูกบัญชี LINE" และ `state` ของ LINE Login
# แบบ stateless (ไม่มีตารางเก็บรหัส/state ตามกติกา Phase 4)
# ⚠️ ไม่ตั้งค่านี้ = ออกรหัสไม่ได้ ตรวจรหัสไม่ผ่าน และ LINE Login ใช้ไม่ได้ (fail-closed ตั้งใจ)
# สร้างค่าสุ่ม: openssl rand -base64 32
LINE_LINK_SECRET=

# [WO-4.D] โดเมนของแอป — ใช้ประกอบ redirect_uri ของ LINE Login
# ไม่ตั้งก็ได้ (ระบบเดาจาก header `host` ของ request) แต่ตั้งไว้จะแน่นอนกว่าเมื่ออยู่หลัง proxy
# ⚠️ ต้องตรงกับ Callback URL ที่ลงทะเบียนไว้ใน LINE Developers Console
APP_BASE_URL=

# -----------------------------------------------------------------------------
# ค่าที่ **ไม่ได้** อยู่ใน env — ตั้งในหน้าตั้งค่าก๊วน (เก็บลง Supabase Vault)
# -----------------------------------------------------------------------------
# ค่าเหล่านี้เป็นของ **แต่ละก๊วน** ไม่ใช่ของระบบ ⇒ แอดมินก๊วนกรอกเองที่
# /gangs/<gangId>/settings แล้วระบบเก็บลง Vault (ตารางเก็บแค่ secret id — WO-4.A)
#
#   · Channel access token (Messaging API)
#       LINE Developers Console → Provider → **Messaging API channel**
#       → แท็บ "Messaging API" → Channel access token (long-lived) → Issue
#   · Channel secret (Messaging API)
#       แท็บ "Basic settings" → Channel secret  ← ใช้ verify ลายเซ็น webhook
#       และตั้ง Webhook URL เป็น  <โดเมน>/api/line/webhook/<gangId>
#   · Login channel ID + secret (LINE Login) — [WO-4.D]
#       สร้าง **LINE Login channel** ใน provider **เดียวกัน** กับ Messaging API
#       (คนละ provider = LINE ให้ userId คนละใบ ⇒ ผูกบัญชีได้แต่ส่งข้อความไม่ถึง)
#       → Basic settings → Channel ID / Channel secret
#       → LINE Login → Callback URL = <โดเมน>/api/line/login/callback
#   · LIFF ID — [WO-4.E]
#       LINE Login channel → แท็บ LIFF → Add → Endpoint URL = <โดเมน>/gangs/<gangId>/liff
